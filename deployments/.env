# --- This release ------------------------------------------------------------
CARE_CLINIC_VERSION=0.1.10


# --- Third-party images -----------------------------------------------------
POSTGRES_IMAGE=postgres:17.10-alpine
REDIS_IMAGE=redis:8.8.0-alpine
MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-03T13-18-01Z
CADDY_IMAGE=caddy:2.11.4
CORAZA_VERSION=v2.6.1

# --- Local image names the stack runs ----------------------------------------
BACKUP_IMAGE=care-backup:clinic
CADDY_WAF_IMAGE=care-caddy:clinic
BACKEND_IMAGE=care:clinic
FRONTEND_IMAGE=care_fe:clinic

# --- CARE release lines -------------------------------------------------------
# CI builds every commit of each maintained CARE line into images and lists
# them here (see docs/images-and-lines.md). A new clinic installs the default
# line and then follows that line's bug fixes until it chooses to upgrade.
CARE_LINES_URL=https://ohcnetwork.github.io/care_clinic/lines.json
CARE_DEFAULT_LINE=preview

# --- Optional CI-built proxy and backup images --------------------------------
# name@sha256:... from the app release workflow. Leave empty to build them on
# the clinic computer from caddy.Dockerfile and backup.Dockerfile.
CADDY_WAF_PREBUILT=
BACKUP_PREBUILT=

# --- Prerequisite installers the app downloads -------------------------------
