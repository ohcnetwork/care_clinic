DJANGO_SETTINGS_MODULE=config.settings.production

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_DB=care
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@db:5432/care

# --- Redis (cache + Celery queue) -------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- Django core ------------------------------------------------------------
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=["*"]
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=False
# Sentry OFF: settings only init Sentry when SENTRY_DSN is non-empty.
SENTRY_DSN=
# Needed for /admin POSTs. https-only origin.
CSRF_TRUSTED_ORIGINS=["https://example.local"]

# --- Object storage (MinIO, S3-compatible) ----------------------------------
BUCKET_EXTERNAL_ENDPOINT=https://example.local
BUCKET_ENDPOINT=http://minio:9000
BUCKET_REGION=ap-south-1
BUCKET_KEY=minioadmin
BUCKET_SECRET=minioadmin
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket

# --- Things the production settings expect (offline-safe placeholders) -------
SNS_ACCESS_KEY=123
SNS_SECRET_KEY=123
EMAIL_HOST=123
EMAIL_USER=123
EMAIL_PASSWORD=123

# --- SMS / OTP --------------------------------------------------------------
USE_SMS=False

SMS_BACKEND="care.utils.sms.backend.console.ConsoleBackend"

# --- Login rate limit -------------------------------------------------------
DISABLE_RATELIMIT=True

# --- Backups ----------------------------------------------------------------
# how many days backup you want to keep. 0 mean keep all
DB_BACKUP_RETENTION_PERIOD=14

# --- Reverse proxy WAF ------------------------------------------------------
# Off (inert) | DetectionOnly (evaluate + log, never block) | On (block with 403).
CORAZA_MODE=Off
