REACT_CARE_API_URL=https://example.local

REACT_DISABLE_PATIENT_LOGIN=true

REACT_RECAPTCHA_SITE_KEY=

REACT_MFE_REGISTERED_COMPONENTS=UserDashboard

# Leave blank for no preset visit type. hh selects Home health.
REACT_DEFAULT_ENCOUNTER_TYPE=

# CARE currently treats 0 as one required address level, not an optional address.
REACT_PATIENT_REG_MIN_GEO_ORG_LEVELS_REQUIRED=0

# Optional UUID of an existing CARE geographic organization to prefill.
# Uncomment only with a valid UUID; CARE rejects an empty assignment.
# REACT_PATIENT_REGISTRATION_DEFAULT_GEO_ORG=
